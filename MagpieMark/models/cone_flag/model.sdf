<?xml version="1.0"?>

<sdf version="1.10">
    <model name="cone_flag">

        <static>true</static>

        <link name="link">

            <!-- Visual geometry -->
            <visual name="visual">

                <geometry>
                    <mesh>
                        <uri>model://cone_flag/meshes/gazebo_flag.STL</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>

            </visual>

            <!-- Collision geometry -->
            <collision name="collision">

                <geometry>
                    <mesh>
                        <uri>model://cone_flag/meshes/gazebo_flag.STL</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>

            </collision>

        </link>

    </model>
</sdf>
